{
	"name": "business-blocks",
	"version": "1.0.0",
	"private": true,
	"description": "Gutenberg blocks for small-business sites: FAQ, business hours, pricing, testimonials, team and call to action.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks --webpack-copy-php",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks --webpack-copy-php",
		"lint:js": "wp-scripts lint-js src tests/js",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"test": "wp-scripts test-unit-js --testPathPattern=tests/js"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"typescript": "~5.6.3"
	}
}
